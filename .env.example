# Copy this to .env.local and fill in real values from the Supabase project settings.
# Never commit .env.local — it's gitignored on purpose.

# Supabase project URL and public (anon) key — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase service role key — Project Settings → API → service_role secret.
# Server-only, never exposed to the browser. Used for admin-level operations
# that bypass RLS (e.g. reading data for scripts/migrations outside the app).
SUPABASE_SERVICE_ROLE_KEY=
